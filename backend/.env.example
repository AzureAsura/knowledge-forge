DATABASE_URL=postgres://user:password@localhost:5432/dbname?sslmode=disable
PORT=8080
JWT_SECRET=change-me-to-a-long-random-string

ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-min-8-chars
ADMIN_NAME=Admin

# Development only. "development" enables /dev/* routes (loopback only) to toggle the rate limiter at
# runtime. Leave it unset in production.
APP_ENV=development
# Initial state of the rate limiter (default true). Can also be flipped at runtime via /dev/rate-limit.
RATE_LIMIT_ENABLED=true
